<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project builds nothing of its own. It exists so that the third-party assemblies the
    module needs are declared in one place and resolved by NuGet at build time, rather than
    being checked in as binaries. Build.ps1 publishes it to a staging folder and copies the
    assemblies it needs into the module's lib folder.

    AvalonEdit provides the JSON editor in Edit-GrouperDocument. It is MIT licensed.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

</Project>
